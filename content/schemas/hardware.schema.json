{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacentertycoon.dev/schemas/hardware.schema.json",
  "title": "Hardware definition",
  "type": "object",
  "required": ["id", "schemaVersion", "name", "researchId", "family", "generation", "purchaseFactor", "computeFactor", "powerFactor", "heatFactor", "flexibility01", "embodiedFactor", "lifeYears", "workloadAffinity", "requiredCoolingKwPerRack", "baseAnnualFailureRate", "refurbished", "resaleValue01"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/permanentId" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "researchId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/permanentId" }, { "type": "null" }] },
    "family": { "enum": ["cpu", "gpu", "asic", "storage", "archive", "experimental"] },
    "generation": { "type": "integer", "minimum": 1 },
    "purchaseFactor": { "$ref": "common.schema.json#/$defs/positive" },
    "computeFactor": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "powerFactor": { "$ref": "common.schema.json#/$defs/positive" },
    "heatFactor": { "$ref": "common.schema.json#/$defs/positive" },
    "flexibility01": { "$ref": "common.schema.json#/$defs/unitInterval" },
    "embodiedFactor": { "$ref": "common.schema.json#/$defs/positive" },
    "lifeYears": { "$ref": "common.schema.json#/$defs/positive" },
    "workloadAffinity": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 4 } },
    "requiredCoolingKwPerRack": { "$ref": "common.schema.json#/$defs/positive" },
    "baseAnnualFailureRate": { "$ref": "common.schema.json#/$defs/unitInterval" },
    "refurbished": { "type": "boolean" },
    "resaleValue01": { "$ref": "common.schema.json#/$defs/unitInterval" }
  },
  "additionalProperties": false
}
