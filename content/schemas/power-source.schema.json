{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacentertycoon.dev/schemas/power-source.schema.json",
  "title": "Power source definition",
  "type": "object",
  "required": ["id", "schemaVersion", "name", "researchId", "kind", "capexFactor", "variableCostFactor", "priceMode", "dispatchability01", "carbonMode", "carbonFactor", "landHectaresPerMw", "communityDelta", "communityDeltaPerRunHour", "renewable", "clean", "storageDurationHours", "roundTripEfficiency01", "degradationPerCycle01", "fuelPerMwh", "baseAnnualFailureRate", "leadTimeDays", "lifeYears"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/permanentId" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "researchId": { "oneOf": [{ "$ref": "common.schema.json#/$defs/permanentId" }, { "type": "null" }] },
    "kind": { "enum": ["import", "generation", "storage", "contract"] },
    "capexFactor": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "variableCostFactor": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "priceMode": { "enum": ["regional", "fixed"] },
    "dispatchability01": { "$ref": "common.schema.json#/$defs/unitInterval" },
    "carbonMode": { "enum": ["regional", "fixed", "fuel"] },
    "carbonFactor": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "landHectaresPerMw": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "communityDelta": { "type": "number", "minimum": -50, "maximum": 50 },
    "communityDeltaPerRunHour": { "type": "number", "minimum": -5, "maximum": 5 },
    "renewable": { "type": "boolean" },
    "clean": { "type": "boolean" },
    "storageDurationHours": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "roundTripEfficiency01": { "$ref": "common.schema.json#/$defs/unitInterval" },
    "degradationPerCycle01": { "$ref": "common.schema.json#/$defs/unitInterval" },
    "fuelPerMwh": { "$ref": "common.schema.json#/$defs/nonNegative" },
    "baseAnnualFailureRate": { "$ref": "common.schema.json#/$defs/unitInterval" },
    "leadTimeDays": { "type": "integer", "minimum": 0 },
    "lifeYears": { "$ref": "common.schema.json#/$defs/positive" }
  },
  "additionalProperties": false
}
