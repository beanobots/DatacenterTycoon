{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacentertycoon.dev/schemas/balance-profile.schema.json",
  "title": "Balance profile definition",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "name",
    "baseRackPowerKw",
    "baseRackComputeUnits",
    "baseRackPurchaseCost",
    "baseRackEmbodiedKgCo2e",
    "baseRevenuePerComputeUnitHour",
    "baseCoolingOverhead01",
    "baseElectricalLoss01",
    "baseAuxiliaryLoad01",
    "baseCoolingCapexPerMw",
    "basePowerCapexPerMw",
    "baseCarbonKgPerMwh",
    "basePricePerMwh",
    "baseHallCapexPerMw",
    "baseMaintenance01",
    "baseAnnualSalary",
    "racksPerStaff",
    "researchStaffShare01",
    "thermalThrottleStartC",
    "thermalShutdownC",
    "referenceInletTempC",
    "annualInterestRate01",
    "annualDepreciation01",
    "wasteLandfillCostPerTonne",
    "wasteRecyclingCostPerTonne",
    "rackMassTonnes",
    "heatSaleRevenuePerMwh",
    "annualInsurance01"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/permanentId"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "baseRackPowerKw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRackComputeUnits": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRackPurchaseCost": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRackEmbodiedKgCo2e": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRevenuePerComputeUnitHour": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseCoolingOverhead01": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseElectricalLoss01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "baseAuxiliaryLoad01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "baseCoolingCapexPerMw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "basePowerCapexPerMw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseCarbonKgPerMwh": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "basePricePerMwh": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseHallCapexPerMw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseMaintenance01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "baseAnnualSalary": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "racksPerStaff": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "thermalThrottleStartC": {
      "type": "number"
    },
    "thermalShutdownC": {
      "type": "number"
    },
    "referenceInletTempC": {
      "type": "number"
    },
    "annualInterestRate01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "annualDepreciation01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "wasteLandfillCostPerTonne": {
      "type": "number"
    },
    "wasteRecyclingCostPerTonne": {
      "type": "number"
    },
    "rackMassTonnes": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "heatSaleRevenuePerMwh": {
      "$ref": "common.schema.json#/$defs/nonNegative"
    },
    "annualInsurance01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "researchStaffShare01": {
      "$ref": "common.schema.json#/$defs/unitInterval",
      "description": "Share of staff available to work as research specialists."
    }
  },
  "additionalProperties": false
}
