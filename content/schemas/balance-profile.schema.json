{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datacentertycoon.dev/schemas/balance-profile.schema.json",
  "title": "Balance profile definition",
  "type": "object",
  "required": [
    "id",
    "schemaVersion",
    "name",
    "baseRackPowerKw",
    "baseRackComputeUnits",
    "baseRackPurchaseCost",
    "baseRackEmbodiedKgCo2e",
    "baseRevenuePerComputeUnitHour",
    "baseCoolingOverhead01",
    "baseElectricalLoss01",
    "baseAuxiliaryLoad01",
    "baseCoolingCapexPerMw",
    "basePowerCapexPerMw",
    "baseCarbonKgPerMwh",
    "basePricePerMwh",
    "baseHallCapexPerMw",
    "baseMaintenance01",
    "baseAnnualSalary",
    "racksPerStaff",
    "researchStaffShare01",
    "thermalThrottleStartC",
    "thermalShutdownC",
    "referenceInletTempC",
    "annualInterestRate01",
    "annualDepreciation01",
    "wasteLandfillCostPerTonne",
    "wasteRecyclingCostPerTonne",
    "rackMassTonnes",
    "heatSaleRevenuePerMwh",
    "annualInsurance01",
    "era",
    "contractPriceScale"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/permanentId"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "baseRackPowerKw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRackComputeUnits": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRackPurchaseCost": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRackEmbodiedKgCo2e": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseRevenuePerComputeUnitHour": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseCoolingOverhead01": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseElectricalLoss01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "baseAuxiliaryLoad01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "baseCoolingCapexPerMw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "basePowerCapexPerMw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseCarbonKgPerMwh": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "basePricePerMwh": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseHallCapexPerMw": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "baseMaintenance01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "baseAnnualSalary": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "racksPerStaff": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "thermalThrottleStartC": {
      "type": "number"
    },
    "thermalShutdownC": {
      "type": "number"
    },
    "referenceInletTempC": {
      "type": "number"
    },
    "annualInterestRate01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "annualDepreciation01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "wasteLandfillCostPerTonne": {
      "type": "number"
    },
    "wasteRecyclingCostPerTonne": {
      "type": "number"
    },
    "rackMassTonnes": {
      "$ref": "common.schema.json#/$defs/positive"
    },
    "heatSaleRevenuePerMwh": {
      "$ref": "common.schema.json#/$defs/nonNegative"
    },
    "annualInsurance01": {
      "$ref": "common.schema.json#/$defs/unitInterval"
    },
    "researchStaffShare01": {
      "$ref": "common.schema.json#/$defs/unitInterval",
      "description": "Share of staff available to work as research specialists."
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "computePerRack",
        "revenuePerComputeUnit",
        "rackPowerKw",
        "rackCost",
        "demandIndex",
        "offerCountIndex",
        "costIndex"
      ],
      "description": "How the industry moves across the campaign window, as multipliers on the base values at anchor years. Every curve is 1.0 in 2025, the year the rest of this profile was tuned for, so history scales around the existing balance rather than replacing it. Without these a thirty-year campaign is one year repeated and no contract price can be right at both ends of it.",
      "properties": {
        "computePerRack": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Compute a rack delivers, against the 2006 baseline."
        },
        "revenuePerComputeUnit": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "What a unit of compute sells for, against 2006."
        },
        "rackPowerKw": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Rack power draw, against 2006: density is why cooling keeps getting harder."
        },
        "rackCost": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Capital cost per rack, against 2006. Roughly flat in nominal terms."
        },
        "demandIndex": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Real growth in how much work a single contract represents, in RACKS rather than compute units. Scaling contract size by the compute curve alone keeps racks-per-contract constant, so a fleet would shrink as hardware improved; this is the industry actually getting bigger."
        },
        "offerCountIndex": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "Multiplier on how many offers reach the market each month. More customers exist in 2030 than in 2006."
        },
        "costIndex": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "value"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1990,
                "maximum": 2100
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "description": "General price level for labour and services - staff, insurance, transit, maintenance, construction, land and research - against 2025. Hardware is NOT scaled by this: it has its own rackCost curve, because a rack cost about the same in nominal dollars in 2006 as it does now while everything around it got dearer."
        }
      }
    },
    "contractPriceScale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Global level for what compute sells for. Contract archetypes carry the RELATIVE price of each kind of work; this carries the level, so the whole book can be tuned against the cost base without editing ten files and losing their relationships to each other."
    }
  },
  "additionalProperties": false
}
