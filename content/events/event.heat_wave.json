{
  "id": "event.heat_wave",
  "schemaVersion": 1,
  "name": "Heat Wave",
  "description": "A multi-day extreme heat episode. Dry coolers lose capacity exactly when the grid is most stressed.",
  "eventClass": "environmental",
  "trigger": {
    "dailyProbability": 0.004,
    "minimumYear": 1995,
    "hazardKey": "heatWave",
    "requiresCondition": {
      "metric": "weather.dryBulbC",
      "comparison": "gt",
      "value": 30
    },
    "cooldownDays": 21
  },
  "durationDays": 6,
  "durationVarianceDays": 4,
  "effects": [
    {
      "target": "cooling.energyFactor",
      "operation": "multiply",
      "value": 1.22,
      "priority": 20
    },
    {
      "target": "cooling.capacity",
      "operation": "multiply",
      "value": 0.82,
      "priority": 20
    },
    {
      "target": "water.freshwaterDemand",
      "operation": "multiply",
      "value": 1.3,
      "priority": 20
    }
  ],
  "immediateCash": 0,
  "immediateTrust": -2,
  "immediateReputation": 0,
  "mitigation": "Activate evaporative assist, shed or defer flexible workloads, and protect the high-SLA tenants first."
}
